# Copy to .env and fill in. Never commit .env.
ENV=dev

DATABASE_URL=postgresql+psycopg://stocksense:change-me@localhost:5432/stocksense
TEST_DATABASE_URL=postgresql+psycopg://stocksense:change-me@localhost:5432/stocksense_test

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=change-me-to-another-long-random-string
JWT_EXPIRE_MINUTES=720
COOKIE_SECURE=false

# Leave SMTP_HOST empty in dev: OTP codes are then written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=StockSense <no-reply@stocksense.local>

FRONTEND_ORIGIN=http://localhost:3000
